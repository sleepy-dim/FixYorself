<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_title"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="LifeLock" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_streak"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFA24C" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/w_habits"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#C7CCDA" android:textSize="13sp" />

    <ProgressBar android:id="@+id/w_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="8dp" android:max="100"
        android:progressTint="#7C5CFF" android:progressBackgroundTint="#2A2E3B" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_b1"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:background="@drawable/widget_btn_accent" android:gravity="center" android:padding="10dp"
            android:singleLine="true" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_b2"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_green" android:gravity="center" android:padding="10dp"
            android:singleLine="true" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_b3"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_btn_dark" android:gravity="center" android:padding="10dp"
            android:singleLine="true" android:text="🎧 Focus" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
